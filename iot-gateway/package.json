{
  "name": "casa-inteligente-iot-gateway",
  "version": "1.0.0",
  "description": "Serviço profissional de IoT Gateway para Casa Inteligente I.A. (MQTT, ESP32, Zigbee2MQTT, Home Assistant e Matter)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "broker": "tsx src/broker/standalone.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "iot",
    "gateway",
    "mqtt",
    "home-assistant",
    "zigbee2mqtt",
    "esp32",
    "matter",
    "smart-home"
  ],
  "author": "Casa Inteligente I.A.",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@supabase/supabase-js": "^2.49.1",
    "aedes": "^1.2.0",
    "fastify": "^5.2.1",
    "mqtt": "^5.10.4",
    "pino": "^9.6.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
