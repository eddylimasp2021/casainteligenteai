# =====================================================================
# CASA INTELIGENTE I.A. — IoT Gateway Environment Configuration
# =====================================================================
# Este arquivo contém apenas valores fictícios/exemplo. NUNCA versione senhas reais.

NODE_ENV=production
PORT=8080
GATEWAY_ID=gw-home-001
GATEWAY_NAME="Gateway Principal Sala"
GATEWAY_API_TOKEN=replace-with-secret-min-32-chars

# MQTT Broker (Mosquitto / HiveMQ / Embedded Aedes)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=casa-gateway-user
MQTT_PASSWORD=casa-gateway-pass-secure
MQTT_CLIENT_ID=casa-inteligente-gateway
MQTT_RECONNECT_PERIOD_MS=2000
MQTT_CONNECT_TIMEOUT_MS=10000

# Embedded MQTT Broker (permite rodar sem Docker no Windows)
EMBEDDED_MQTT_BROKER=true
MQTT_BROKER_PORT=1883
MQTT_BROKER_HOST=0.0.0.0

# Home Assistant (Opcional - modo degradado caso não configurado)
HOME_ASSISTANT_URL=http://homeassistant:8123
HOME_ASSISTANT_TOKEN=replace-with-long-lived-token

# Zigbee2MQTT (Opcional - tópico base)
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt

# Matter Controller (Opcional)
# Exemplo: socket de comunicação com chip-tool / python-matter-server
MATTER_CONTROLLER_URL=http://matter-server:5580
MATTER_ENABLED=false

# Supabase Backend (para persistência de telemetria, eventos e estados)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Observabilidade
LOG_LEVEL=info
COMMAND_TIMEOUT_MS=30000
RATE_LIMIT_MAX=120
